{
  "name": "truco-de-turing",
  "version": "2.4.3",
  "description": "Jogo de cartas em Phaser para ensinar redes neurais e deep learning (FPO 2026/2, tema 4).",
  "main": "index.html",
  "scripts": {
    "start": "npx http-server -c-1 -p 8080 .",
    "build": "node ferramentas/empacotar.js",
    "simular": "node ferramentas/simular.js 300 guloso aleatorio",
    "testar": "node --test \"testes/unidade/*.test.js\"",
    "testar:interface": "node --test \"testes/interface/*.test.js\"",
    "testar:performance": "node --test --test-concurrency=1 \"testes/performance/*.test.js\"",
    "testar:tudo": "npm run testar && npm run testar:interface && npm run testar:performance",
    "relatorios": "node ferramentas/relatorios.js",
    "docs": "node ferramentas/documentar.js"
  },
  "keywords": [
    "phaser",
    "machine-learning",
    "neural-networks",
    "card-game",
    "truco",
    "educacao"
  ],
  "license": "GPL-3.0-only",
  "author": "Welyngton José Vinicius Dal Prá",
  "contributors": [
    "Diego Casagrande",
    "Vinícius Chiconato",
    "Suzy Arcanjo",
    "Francisco Lima (motor do NeuroDeck)"
  ],
  "dependencies": {
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "c8": "^11.0.0",
    "esbuild": "^0.24.2",
    "jsdom": "^26.1.0",
    "playwright": "^1.63.0"
  },
  "type": "module"
}
